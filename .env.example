# ============================================================================
#  SkillScale — environment variables
#  Copy to .env.local for local dev. Set the same keys in your host (Vercel:
#  Settings > Environment Variables). Never commit a filled-in copy.
# ============================================================================

# --- Supabase: database, auth and file storage -----------------------------
# Supabase Dashboard > Settings > API

# Project URL, e.g. https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Public by design — it is shipped to the browser and
# every query it makes is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET. Bypasses Row Level Security entirely.
# Required by app/api/webhooks/razorpay/route.ts: the webhook is a server-to-server
# call with no user session, so auth.uid() is NULL and every RLS policy that calls
# is_admin() rejects the write. Without this, payments succeed and customers get
# nothing.
# NEVER prefix this with NEXT_PUBLIC_ — that would inline it into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay: payments ----------------------------------------------------
# Razorpay Dashboard > Settings > API Keys. Use rzp_test_* keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard > Settings > Webhooks > (your endpoint) > Secret.
# You can only generate this AFTER your site has a live HTTPS URL to point the
# webhook at. Generate a strong value with:  openssl rand -hex 32
# It must match byte-for-byte between Razorpay and this variable.
RAZORPAY_WEBHOOK_SECRET=

# --- Resend: post-purchase delivery email ----------------------------------
# resend.com > API Keys. Optional: if unset, purchases still record correctly and
# customers can download from their account page, they just get no email.
RESEND_API_KEY=

# The "from" address for delivery emails, e.g. orders@yourdomain.com
# Must be on a domain you have verified in Resend.
EMAIL_FROM=
